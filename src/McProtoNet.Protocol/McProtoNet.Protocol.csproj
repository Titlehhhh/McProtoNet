<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <NoWarn>CS8618;CS1591;CS8601</NoWarn>
    </PropertyGroup>
    <PropertyGroup>
        <Description>A library that supports multiversion</Description>
    </PropertyGroup>
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS0535</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <IncludeHandshakePackets>true</IncludeHandshakePackets>
        <IncludeLoginPackets>true</IncludeLoginPackets>
        <IncludeStatusPackets>true</IncludeStatusPackets>
        <IncludeConfigurationPackets>true</IncludeConfigurationPackets>
        <IncludePlayClientboundPackets>false</IncludePlayClientboundPackets>
        <IncludePlayServerboundPackets>false</IncludePlayServerboundPackets>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Packets/Handshaking/**/*.cs" Condition="'$(IncludeHandshakePackets)' == 'false'" />
        <Compile Remove="Packets/Login/**/*.cs" Condition="'$(IncludeLoginPackets)' == 'false'" />
        <Compile Remove="Packets/Status/**/*.cs" Condition="'$(IncludeStatusPackets)' == 'false'" />
        <Compile Remove="Packets/Configuration/**/*.cs" Condition="'$(IncludeConfigurationPackets)' == 'false'" />
        <Compile Remove="Packets/Play/Clientbound/**/*.cs" Condition="'$(IncludePlayClientboundPackets)' == 'false'" />
        <Compile Remove="Packets/Play/Serverbound/**/*.cs" Condition="'$(IncludePlayServerboundPackets)' == 'false'" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="McProtoNet.Benchmark"/>
        <InternalsVisibleTo Include="McProtoNet.Tests"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\McProtoNet.Serialization\McProtoNet.Serialization.csproj"/>
        <ProjectReference Include="..\McProtoNet\McProtoNet.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Dunet"/>
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\McProtoNet.SourceGenerator\McProtoNet.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>



</Project>
