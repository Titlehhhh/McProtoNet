<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>
    <PropertyGroup>
        <Description>Client glue over the transport and the packet layer: connect, typed send, server lookup</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Readme.md"/>
        <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="McProtoNet.Benchmark"/>
        <InternalsVisibleTo Include="McProtoNet.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\McProtoNet.Transport\McProtoNet.Transport.csproj"/>
        <ProjectReference Include="..\McProtoNet.Protocol\McProtoNet.Protocol.csproj"/>
    </ItemGroup>

</Project>
